{
  "random_seed": 42,
  "evaluation": {
    "test_size": 0.2
  },
  "experiments": {
    "enabled": true,
    "frequency_models": [
      "poisson",
      "random_forest",
      "xgboost"
    ],
    "severity_models": [
      "gamma",
      "random_forest",
      "xgboost"
    ],
    "sample_fraction": 0.2,
    "max_frequency_rows": 30000,
    "max_severity_rows": 30000,
    "random_forest_n_estimators": 80,
    "xgboost_n_estimators": 120
  },
  "models": {
    "frequency_model": "poisson",
    "severity_model": "gamma",
    "frequency": {
      "alpha": 0.0001,
      "max_iter": 1000,
      "random_forest": {
        "n_estimators": 300,
        "max_depth": null,
        "min_samples_leaf": 1,
        "n_jobs": -1
      },
      "xgboost": {
        "n_estimators": 300,
        "learning_rate": 0.05,
        "max_depth": 6,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_lambda": 1.0
      }
    },
    "severity": {
      "alpha": 0.0001,
      "max_iter": 1000,
      "random_forest": {
        "n_estimators": 300,
        "max_depth": null,
        "min_samples_leaf": 1,
        "n_jobs": -1
      },
      "xgboost": {
        "n_estimators": 400,
        "learning_rate": 0.05,
        "max_depth": 6,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_lambda": 1.0
      }
    }
  },
  "feature_engineering": {
    "exposure_lower_bound": 1e-06,
    "numeric_defaults": {
      "Exposure": 0.49,
      "VehPower": 6.0,
      "VehAge": 6.0,
      "DrivAge": 44.0,
      "BonusMalus": 50.0,
      "Density": 393.0
    },
    "categorical_defaults": {
      "VehBrand": "B12",
      "VehGas": "Regular",
      "Area": "C",
      "Region": "Centre"
    },
    "numeric_clip_bounds": {
      "Exposure": {
        "min": 1e-06,
        "max": 2.5
      },
      "VehPower": {
        "min": 1.0,
        "max": 20.0
      },
      "VehAge": {
        "min": 0.0,
        "max": 100.0
      },
      "DrivAge": {
        "min": 18.0,
        "max": 100.0
      },
      "BonusMalus": {
        "min": 50.0,
        "max": 350.0
      },
      "Density": {
        "min": 0.0,
        "max": 27000.0
      }
    },
    "optional_simulated_features": [
      "simulated_vehicle_type",
      "simulated_daily_mileage",
      "simulated_night_driving_level",
      "simulated_harsh_braking_level",
      "simulated_accidents_last_2yr",
      "simulated_claim_history"
    ]
  },
  "pricing": {
    "fx_rate_to_inr": 93.0,
    "expense_loading": 0.3,
    "fixed_expense": 500.0,
    "minimum_premium": 2500.0,
    "risk_score_scale": 100.0,
    "risk_score_baseline_floor": 1.0,
    "annualized_expected_loss_thresholds": {
      "low_max": 15000.0,
      "medium_max": 40000.0
    }
  }
}
